{
  "name": "smena-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Smena Manager: a shared task and knowledge workspace for the team.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch src/server/index.js",
    "start:server": "node src/server/index.js",
    "build": "vite build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "test:server": "node --test tests/server/*.test.js",
    "test:e2e": "playwright test",
    "check:ui": "node scripts/check-ui-matrix.js",
    "check:tokens": "node scripts/check-ui-tokens.js",
    "check:ergonomics": "node scripts/check-ui-ergonomics.js",
    "check:visual": "node scripts/check-visual-baselines.js",
    "setup:gmail": "node scripts/setup-gmail-oauth.js",
    "setup:storage": "node scripts/setup-storage.js",
    "check:deploy": "node scripts/check-deployment-config.js",
    "check:live": "node scripts/smoke-deployment.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "postinstall": "node scripts/build-sanitizer.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.0",
    "cytoscape": "^3.34.4",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.11.1",
    "marked": "18.1.2",
    "multer": "^2.5.0",
    "pdfjs-dist": "6.4.299",
    "sanitize-html": "2.18.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide": "^0.460.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "vite": "^6.4.4"
  }
}
