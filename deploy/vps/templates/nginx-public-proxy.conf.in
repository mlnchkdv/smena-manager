# Managed by Smena Manager VPS kit. Public capability routes only.
proxy_pass http://127.0.0.1:3001;
proxy_http_version 1.1;
proxy_set_header Host {{DOMAIN}};
proxy_set_header X-Forwarded-Host {{DOMAIN}};
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Connection "";
proxy_cache off;
proxy_request_buffering off;
proxy_buffering off;
proxy_read_timeout 300s;
proxy_send_timeout 300s;
proxy_intercept_errors off;
access_log off;
proxy_hide_header Cache-Control;
{{HIDE_PUBLIC_SECURITY_HEADERS}}
add_header Cache-Control "no-store" always;
# These add_header directives replace the server-level inheritance. In particular,
# do not add the website CSP or Referrer-Policy over the stricter upstream values.
include /etc/nginx/snippets/smena-manager-public-security.conf;
