# Literal KEY=value only: no shell expansion, quotes, spaces or inline comments.
# /etc/smena-manager/smena.env; root:smena, mode 0640. Never commit real values.
NODE_ENV=production
PORT=3001
TRUST_PROXY=loopback
APP_ORIGIN=https://CHANGE_DOMAIN
WORKSPACE_WRITE_MODE=drive
KNOWLEDGE_CATALOG_ENABLED=false
ACCESS_ID_LOGIN_ENABLED=false
ACCESS_IDS_PATH=/etc/smena-manager/access-ids.json
SESSION_SECRET=CHANGE_TO_EXISTING_OR_RANDOM_64_HEX_CHARACTERS
CRON_SECRET=CHANGE_TO_RANDOM_64_HEX_CHARACTERS
NODE_OPTIONS=--max-old-space-size=2048

GOOGLE_CLIENT_ID=CHANGE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE
GOOGLE_REFRESH_TOKEN=CHANGE
GOOGLE_DRIVE_FOLDER_ID=CHANGE
GOOGLE_DRIVE_DATABASE_FILE_ID=CHANGE
GOOGLE_DRIVE_UPLOADS_FOLDER_ID=CHANGE
GOOGLE_DRIVE_BACKUPS_FOLDER_ID=CHANGE
GOOGLE_DRIVE_SESSIONS_FILE_ID=CHANGE
GOOGLE_DRIVE_PUSH_FILE_ID=CHANGE
GOOGLE_DRIVE_DELIVERY_FILE_ID=CHANGE
# Preserve these IDs too when the existing installation has them.
GOOGLE_DRIVE_KNOWLEDGE_FILE_ID=
GOOGLE_DRIVE_BOOKMARKS_FILE_ID=

# Preserve existing authorized sender, dedicated Gmail grant and VAPID keys.
# Leave each optional group entirely empty only when that feature is unused.
EMAIL_FROM=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ADMIN_EMAIL
REMINDER_TIME_ZONE=Europe/Saratov
BACKUP_TIME_ZONE=Europe/Saratov
BACKUP_RETENTION_COUNT=30
NOTIFICATION_LOCALE=ru
SHARED_FILE_MAX_BYTES=21474836480

# Drive stays authoritative. These fixed paths also keep any temporary/local
# service state outside immutable releases; preflight prevents local fallback.
DATABASE_PATH=/var/lib/smena-manager/workspace.json
UPLOADS_PATH=/var/lib/smena-manager/uploads
BACKUPS_PATH=/var/lib/smena-manager/backups
