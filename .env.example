PORT=3001
NODE_ENV=development

# Production on Vercel requires one of the Google Drive credential sets below.
# OAuth2 is the simplest option for a dedicated personal or Workspace account.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# A service account must be granted access to an existing folder or Shared Drive.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_FOLDER_ID=required_for_service_accounts

# Optional IDs avoid Drive lookup requests on cold starts.
# GOOGLE_DRIVE_DATABASE_FILE_ID=your_database_file_id

# Local development only. Vercel refuses local storage.
# DATABASE_PATH=.data/smena-manager-data.json
