PORT=3001
NODE_ENV=development

# Authentication. Use a long random SESSION_SECRET in every deployed environment.
# SESSION_SECRET=replace_with_at_least_32_random_characters
# ACCESS_IDS_JSON=[{"id":"user-1","name":"Team member","email":"member@example.com","role":"admin","accessId":"replace-with-a-random-secret"}]
# Local alternative: copy access-ids.example.json to .data/access-ids.json.
# ACCESS_IDS_PATH=.data/access-ids.json
# Access ID login is enabled locally and disabled on Vercel by default. Enable it
# in production only temporarily as an emergency recovery channel.
# ACCESS_ID_LOGIN_ENABLED=true

# Required before write access is enabled on Vercel. It serializes updates from
# concurrent Function instances so a newer Google Drive snapshot is not overwritten.
# REDIS_URL=rediss://default:password@host:6379

# Production on Vercel requires one of the Google Drive credential sets below.
# OAuth2 is the simplest option for a dedicated personal or Workspace account.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
# Allow the same Google web client on localhost after adding the local origin
# to Google Cloud. Production origins are enabled automatically.
# GOOGLE_LOCALHOST_ENABLED=true

# A service account must be granted access to an existing folder or Shared Drive.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_FOLDER_ID=required_for_service_accounts

# Optional IDs avoid Drive lookup requests on cold starts.
# GOOGLE_DRIVE_DATABASE_FILE_ID=your_database_file_id
# GOOGLE_DRIVE_UPLOADS_FOLDER_ID=your_uploads_folder_id

# Local development only. Vercel refuses local storage.
# DATABASE_PATH=.data/smena-manager-data.json
# UPLOADS_PATH=.data/uploads
# Optional upload limit. Google Drive uploads use resumable browser-to-Drive
# sessions on Vercel, so file bytes do not pass through the Function body.
# SHARED_FILE_MAX_BYTES=104857600

# Protected daily reminder job and Web Push delivery.
# CRON_SECRET=replace_with_a_long_random_secret
# REMINDER_TIME_ZONE=Europe/Saratov
# VAPID_PUBLIC_KEY=generated_public_key
# VAPID_PRIVATE_KEY=generated_private_key
# VAPID_SUBJECT=mailto:admin@example.com
# Gmail API requires the https://www.googleapis.com/auth/gmail.send scope.
# EMAIL_FROM=admin@example.com
# Keep email authorization separate from the Drive token. The Gmail client ID
# and secret may be omitted when the same OAuth web client is used for Drive.
# GMAIL_OAUTH_CLIENT_ID=your_optional_separate_client_id.apps.googleusercontent.com
# GMAIL_OAUTH_CLIENT_SECRET=your_optional_separate_client_secret
# GMAIL_OAUTH_REFRESH_TOKEN=generated_by_npm_run_setup_gmail
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback
# NOTIFICATION_LOCALE=ru
